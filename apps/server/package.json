{
  "name": "@instapay/server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/bootstrap/http.bootstrap.ts",
    "dev:worker": "tsx watch src/bootstrap/worker.bootstrap.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/bootstrap/http.bootstrap.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1139.0",
    "@aws-sdk/s3-request-presigner": "3.1139.0",
    "@azure-rest/ai-vision-image-analysis": "1.0.0-beta.3",
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/csrf-protection": "8.0.1",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@nestjs/bullmq": "12.0.0",
    "@nestjs/common": "12.1.0",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.0",
    "@nestjs/platform-fastify": "12.1.0",
    "@nestjs/swagger": "12.0.2",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/sdk-node": "0.222.0",
    "@sentry/node": "11.0.0",
    "argon2": "0.45.1",
    "bullmq": "6.3.8",
    "dotenv": "18.0.3",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "ioredis": "6.0.0",
    "nestjs-pino": "5.2.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "sharp": "0.35.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11"
  }
}
