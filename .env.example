# Copy this file to .env for local development. Never commit a real value.
# Neon: use the pooled PostgreSQL connection string with sslmode=require.
DATABASE_URL=postgresql://<user>:<password>@<neon-host>/<database>?sslmode=require

# Use managed Redis and S3-compatible private object storage for development.
REDIS_URL=rediss://:<password>@<redis-host>:6379
S3_ENDPOINT=https://<s3-endpoint>
S3_REGION=<region>
S3_BUCKET=<private-bucket-name>
S3_ACCESS_KEY_ID=<access-key-id>
S3_SECRET_ACCESS_KEY=<secret-access-key>

# Server runtime
NODE_ENV=development
SERVER_PORT=3001
CLIENT_ORIGIN=http://localhost:3000
LOG_LEVEL=debug

# Add provider credentials only when the corresponding adapter is implemented.
AZURE_VISION_ENDPOINT=https://<resource-name>.cognitiveservices.azure.com
AZURE_VISION_KEY=<azure-vision-key>
SENTRY_DSN=
